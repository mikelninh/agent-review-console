{
  "name": "agent-review-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint src vite.config.ts --max-warnings=0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.4",
    "typescript": "^5.9.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.542.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "vitest": "^3.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.0",
    "globals": "17.12.0",
    "typescript-eslint": "8.69.0"
  }
}
